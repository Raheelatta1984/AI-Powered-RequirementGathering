# Optional. Without a key, the clearly labelled guided interview engine is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Required for production. Protects the BA workspace with a login passphrase.
WORKSPACE_ACCESS_TOKEN=
# Production requires HTTPS. Set to true behind your HTTPS reverse proxy.
SECURE_COOKIES=false
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Repository catalog: only this owner/repository and a JSON catalog file are read.
CATALOG_REPOSITORY=Raheelatta1984/AI-Powered-RequirementGathering
CATALOG_PATH=catalog/solutions.json
CATALOG_REF=main
# Optional GitHub token for a private catalog repository; never sent to the browser.
GITHUB_TOKEN=

# Optional exact public origin and trusted reverse-proxy hop count.
PUBLIC_ORIGIN=
TRUST_PROXY_HOPS=0
